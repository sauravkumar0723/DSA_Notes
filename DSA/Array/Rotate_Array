# Rotate Array

public class RotateArray {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.println("Enter an array size:");
		int n = sc.nextInt();
		System.out.println("create the array:");
		int arr[] = new int[n];
		System.out.println("Populate the array with user input: ");
		for(int i = 0; i <= arr.length-1; i++) {
			arr[i] = sc.nextInt();
		}
		System.out.println("Rotate the array by right k steps");
		int k = sc.nextInt();
		System.out.println("Rotate the array:");
		int arr2[] = new int[n];
		for(int i = 0; i <= arr.length-1; i++) {
			arr2[(i + k) % n] = arr[i];
		}
		System.out.println(Arrays.toString(arr2));
	}
}

